# Имена переменных. Значения заполняются локально в .env и в credentials n8n.

# Postgres / Supabase (Dokploy)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# n8n
N8N_BASE_URL=
N8N_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# faster-whisper (self-host). Пустые значения: модель large-v3-turbo, int8, 8 потоков.
WHISPER_BASE_URL=
WHISPER_MODEL=
WHISPER_FALLBACK_MODEL=
WHISPER_COMPUTE_TYPE=
WHISPER_CPU_THREADS=
WHISPER_IDLE_EXIT_SEC=
WHISPER_MAX_AUDIO_SEC=
# Если задан, POST сервиса требует Authorization: Bearer. В git значение не класть.
WHISPER_TOKEN=

# Дешёвая LLM
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Облачная папка с лекциями. Сами файлы в git не класть.
GOOGLE_DRIVE_FOLDER_ID=

# Каталог медиа на сервере
DATA_DIR=
