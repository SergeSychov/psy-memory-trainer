      "id": "2ea340b1-fd1b-46a4-b55d-a680378efe65",
      "name": "Fin — Kick psy_03",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        2200,
        300
