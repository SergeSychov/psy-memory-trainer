    {
      "id": "5d791e4b-c2d6-4cf5-8674-14b8fe7c155c",
      "name": "Audio — Requeue Busy",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1320,
        160
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE psy.jobs\nSET status = 'queued',\n    attempts = GREATEST(attempts - 1, 0),\n    error = 'whisper busy (409)',\n    started_at = NULL\nWHERE id = $1::uuid\nRETURNING id, status, attempts",
        "options": {
          "queryReplacement": "={{ [ $('Run — Create Job').item.json.id ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "fVodKFRegu3319i0",
          "name": "psy Supabase (psy_n8n)"
        }
      }
    },
    {
      "id": "d9119a80-a408-4947-9ebc-671fdc6ed30e",
      "name": "Audio — Prep Paths",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        360
      ],
      "parameters": {
        "jsCode": "const job = $('Run — Create Job').item.json;\nconst constants = $('Run — Init Constants').first().json.constants;\nconst payload = typeof job.payload === 'string' ? JSON.parse(job.payload) : (job.payload || {});\nconst ext = payload.ext || 'bin';\nconst lecture_id = job.lecture_id;\nconst inbox_path = `inbox/${lecture_id}.${ext}`;\nconst audio_path = `audio/${lecture_id}.16k.opus`;\nreturn [{\n  json: {\n    ...job,\n    constants,\n    payload,\n    file_id: payload.file_id,\n    ext,\n    lecture_id,\n    inbox_path,\n    audio_path,\n  },\n  pairedItem: 0,\n}];"
      }
    },
    {
      "id": "e715e262-e3b3-4d36-a7e2-5c852bcae35e",
      "name": "Audio — Fetch From Drive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1540,
        360
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.constants.whisper_base || 'http://psy-whisper:8080' }}/drive/fetch",
        "authentication": "predefinedCredentialType",
        "sendBody": true,
        "options": {
          "timeout": 3600000
        },
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ file_id: $json.file_id, output_path: $json.inbox_path }) }}",
        "nodeCredentialType": "googleDriveOAuth2Api"
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "S7mhg7CBYGpInlHx",
          "name": "Google Drive account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "7d765ef5-2bd6-4e86-8c42-940e779ca382",
      "name": "Audio — Extract",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1760,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Audio — Prep Paths').item.json.constants.whisper_base || 'http://psy-whisper:8080' }}/extract-audio",
        "authentication": "genericCredentialType",
        "sendBody": true,
        "options": {
          "timeout": 3600000
        },
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ input_path: $('Audio — Prep Paths').item.json.inbox_path, output_path: $('Audio — Prep Paths').item.json.audio_path, delete_input: true }) }}",
        "genericAuthType": "httpBearerAuth"
      },
      "credentials": {
        "httpBearerAuth": {
          "id": "WeUa8vWm5ugn7AeW",
          "name": "psy Whisper token"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "c8a4422a-1d57-4fa0-8418-5f959e7e05ce",
      "name": "DB — Audio Ready",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1980,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH lec AS (\n  UPDATE psy.lectures\n  SET status = 'audio_ready',\n      duration_sec = COALESCE($2::int, duration_sec),\n      source_meta = COALESCE(source_meta, '{}'::jsonb) || jsonb_build_object(\n        'audio', jsonb_build_object('path', $3, 'duration_sec', $2)\n      ),\n      error = NULL\n  WHERE id = $1::uuid\n  RETURNING id\n), done_job AS (\n  UPDATE psy.jobs\n  SET status = 'done', finished_at = now(), error = NULL\n  WHERE id = $4::uuid\n  RETURNING id\n), enq AS (\n  INSERT INTO psy.jobs (lecture_id, step, status, idempotency_key, payload)\n  VALUES (\n    $1::uuid, 'transcribe', 'queued', 'transcribe:' || $1::text,\n    jsonb_build_object('audio_path', $3, 'workflow_version', $5)\n  )\n  ON CONFLICT (idempotency_key) DO NOTHING\n  RETURNING id\n)\nSELECT (SELECT id FROM lec) AS lecture_id,\n       (SELECT id FROM done_job) AS job_id,\n       (SELECT id FROM enq) AS transcribe_job_id",
        "options": {
          "queryReplacement": "={{ [\n  $('Audio — Prep Paths').item.json.lecture_id,\n  Math.round(Number($json.duration_sec || 0)),\n  $('Audio — Prep Paths').item.json.audio_path,\n  $('Audio — Prep Paths').item.json.id,\n  $('Run — Init Constants').first().json.constants.workflow_version\n] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "fVodKFRegu3319i0",
          "name": "psy Supabase (psy_n8n)"
        }
      }
    },
