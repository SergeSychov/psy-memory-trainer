    {
      "id": "d2a37192-5d47-48dc-b0f2-4aecbda8bb3e",
      "name": "Run — Init Constants",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        360
      ],
      "parameters": {
        "jsCode": "return items.map((item, index) => {\n  const constants = {\n    workflow_version: 'psy_02_extract_audio_v1',\n    whisper_base: 'http://psy-whisper:8080',\n    max_attempts: 3,\n    stale_running_hours: 4,\n  };\n  return { json: { ...item.json, constants }, pairedItem: index };\n});"
      }
    },
    {
      "id": "5fcfeea4-ccf3-415e-96da-b6a15c2776cb",
      "name": "Run — Create Job",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        360
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE psy.jobs j\nSET status = 'running',\n    attempts = attempts + 1,\n    started_at = now(),\n    error = NULL,\n    payload = COALESCE(payload, '{}'::jsonb) || jsonb_build_object('workflow_version', $1, 'claimed_at', now())\nWHERE j.id = (\n  SELECT id FROM psy.jobs\n  WHERE step = 'extract_audio'\n    AND attempts < 3\n    AND (\n      status = 'queued'\n      OR (status = 'running' AND started_at < now() - interval '4 hours')\n    )\n  ORDER BY created_at\n  LIMIT 1\n  FOR UPDATE SKIP LOCKED\n)\nRETURNING j.*",
        "options": {
          "queryReplacement": "={{ [ $('Run — Init Constants').first().json.constants.workflow_version ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "fVodKFRegu3319i0",
          "name": "psy Supabase (psy_n8n)"
        }
      }
    },
