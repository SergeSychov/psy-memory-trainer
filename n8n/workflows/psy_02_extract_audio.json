        "url": "={{ $('Fin — Fail Context').item.json.constants.whisper_base || 'http://psy-whisper:8080' }}/files/delete",
        "authentication": "genericCredentialType",
        "sendBody": true,
        "options": {
          "timeout": 60000
        },
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ path: $('Fin — Fail Context').item.json.inbox_path }) }}",
        "genericAuthType": "httpBearerAuth"
      },
      "credentials": {
        "httpBearerAuth": {
          "id": "WeUa8vWm5ugn7AeW",
          "name": "psy Whisper token"
        }
      },
      "onError": "continueRegularOutput"
    }
