                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "c37dad2b-6fe4-4d46-9499-02e338022c39",
      "name": "DB — Enqueue Extract",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO psy.jobs (\n  lecture_id, step, status, idempotency_key, payload\n) VALUES (\n  $1::uuid, 'extract_audio', 'queued', 'extract_audio:' || $1::text,\n  jsonb_build_object(\n    'file_id', $2,\n    'ext', $3,\n    'size_bytes', $4,\n    'workflow_version', $5\n  )\n)\nON CONFLICT (idempotency_key) DO NOTHING\nRETURNING id, lecture_id, step, status",
        "options": {
          "queryReplacement": "={{ [\n  $json.id,\n  $('Load — Flatten Media').item.json.file_id,\n  $('Load — Flatten Media').item.json.ext,\n  $('Load — Flatten Media').item.json.size_bytes,\n  $('Run — Init Constants').first().json.constants.workflow_version\n] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "fVodKFRegu3319i0",
          "name": "psy Supabase (psy_n8n)"
        }
      }
    },
    {
