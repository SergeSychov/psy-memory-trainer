    {
      "id": "a69e73b8-b845-4198-a271-68cdebfcc3ac",
      "name": "In — Execute",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        600
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "course_id"
            }
          ]
        }
      }
    },
    {
      "id": "69a3d342-dcdb-48c3-a8f0-a003b5226f0f",
      "name": "Run — Init Constants",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        420
      ],
      "parameters": {
        "jsCode": "return items.map((item, index) => {\n  const constants = {\n    workflow_version: 'psy_01_ingest_cloud_folder_v1',\n    whisper_base: 'http://psy-whisper:8080',\n    drive_list_depth: 1,\n    skip_folder_prefix: '_',\n  };\n  const course_id = item.json.course_id || item.json.query?.course_id || null;\n  return {\n    json: { ...item.json, course_id, constants },\n    pairedItem: index,\n  };\n});"
      }
    },
    {
      "id": "55accf3b-3ee6-4a99-83d8-75c9b48b23f1",
      "name": "Load — Courses",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        420
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, user_id, title, drive_folder_id\nFROM psy.courses\nWHERE drive_folder_id IS NOT NULL\n  AND ($1::uuid IS NULL OR id = $1::uuid)",
        "options": {
          "queryReplacement": "={{ [ $('Run — Init Constants').first().json.course_id || null ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "fVodKFRegu3319i0",
          "name": "psy Supabase (psy_n8n)"
        }
      }
    },
    {
      "id": "e942439f-2451-4a30-9c0f-76b98c37c2b4",
      "name": "Load — Drive Media",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        660,
        420
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Run — Init Constants').first().json.constants.whisper_base || 'http://psy-whisper:8080' }}/drive/list-media",
        "authentication": "predefinedCredentialType",
        "sendBody": true,
        "options": {
          "timeout": 120000
        },
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ folder_id: $json.drive_folder_id, depth: ($('Run — Init Constants').first().json.constants.drive_list_depth || 1) }) }}",
        "nodeCredentialType": "googleDriveOAuth2Api"
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "S7mhg7CBYGpInlHx",
          "name": "Google Drive account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "679b3536-cbf7-4448-842e-9a1a8920ee84",
      "name": "Load — Flatten Media",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        420
      ],
      "parameters": {
        "jsCode": "const constants = $('Run — Init Constants').first().json.constants || {\n  workflow_version: 'psy_01_ingest_cloud_folder_v1',\n  skip_folder_prefix: '_',\n};\nconst course = $('Load — Courses').item.json;\nconst files = items[0].json.files || [];\nconst prefix = constants.skip_folder_prefix || '_';\nconst out = [];\nfor (const f of files) {\n  const path = f.folder_path || [];\n  if (path.some((p) => String(p).startsWith(prefix))) continue;\n  const name = f.name || '';\n  const ext = (name.includes('.') ? name.split('.').pop() : 'bin').toLowerCase();\n  out.push({\n    json: {\n      constants,\n      course_id: course.id,\n      file_id: f.id,\n      title: name,\n      media_kind: f.media_kind,\n      duration_sec: f.duration_ms != null ? Math.round(Number(f.duration_ms) / 1000) : null,\n      ext,\n      size_bytes: f.size_bytes,\n      source_meta_drive: {\n        name: f.name,\n        mime_type: f.mime_type,\n        size_bytes: f.size_bytes,\n        md5: f.md5,\n        folder_path: path,\n        modified_time: f.modified_time,\n      },\n    },\n    pairedItem: 0,\n  });\n}\nreturn out;"
      }
    },
    {
      "id": "5cd169f5-ec56-4923-bf61-d49819e4169c",
      "name": "DB — Upsert Lecture",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1100,
        420
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO psy.lectures (\n  course_id, external_file_id, title, media_kind, duration_sec, status, source_meta\n) VALUES (\n  $1::uuid, $2, $3, $4, $5, 'queued',\n  jsonb_build_object('drive', $6::jsonb)\n)\nON CONFLICT (course_id, external_file_id) DO NOTHING\nRETURNING id, course_id, external_file_id, status",
        "options": {
          "queryReplacement": "={{ [\n  $json.course_id,\n  $json.file_id,\n  $json.title,\n  $json.media_kind,\n  $json.duration_sec,\n  JSON.stringify($json.source_meta_drive || {})\n] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "fVodKFRegu3319i0",
          "name": "psy Supabase (psy_n8n)"
        }
      }
    },
    {
      "id": "48358f40-a988-4976-8466-0279304203c4",
      "name": "DB — Has New Lecture",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
